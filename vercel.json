{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:release",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/downloads/Kivuno-0.8.4-macOS-arm64.dmg",
      "destination": "https://github.com/dakiemdarktharr/WWW/releases/download/v0.8.4/Kivuno-0.8.4-macOS-arm64.dmg",
      "statusCode": 307
    },
    {
      "source": "/downloads/Kivuno-0.8.5-macOS-arm64.dmg",
      "destination": "https://github.com/dakiemdarktharr/WWW/releases/download/v0.8.5/Kivuno-0.8.5-macOS-arm64.dmg",
      "statusCode": 307
    },
    {
      "source": "/downloads/Kivuno-0.8.6-macOS-arm64.dmg",
      "destination": "https://github.com/dakiemdarktharr/WWW/releases/download/v0.8.6/Kivuno-0.8.6-macOS-arm64.dmg",
      "statusCode": 307
    },
    {
      "source": "/downloads/Kivuno-0.8.7-macOS-arm64.dmg",
      "destination": "https://github.com/dakiemdarktharr/WWW/releases/download/v0.8.7/Kivuno-0.8.7-macOS-arm64.dmg",
      "statusCode": 307
    },
    {
      "source": "/downloads/Kivuno-0.8.8-macOS-arm64.dmg",
      "destination": "https://github.com/dakiemdarktharr/WWW/releases/download/v0.8.8/Kivuno-0.8.8-macOS-arm64.dmg",
      "statusCode": 307
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nosleepclub-relay.vercel.app" }],
      "destination": "https://kivuno.vercel.app/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/gateway.ts": { "maxDuration": 300, "includeFiles": ".cloud/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?relay_path=:path*" },
    { "source": "/billing", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.avax-test.network; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}

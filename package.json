{
  "name": "relay-workspace",
  "version": "0.6.0",
  "private": true,
  "overrides": {
    "zod": "$zod"
  },
  "type": "module",
  "description": "Kivuno — a desktop workspace for real Codex teams",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-cloud.mjs",
    "build:release": "node scripts/build-release.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:cloud": "tsx tests/cloud.e2e.ts",
    "test:portal": "tsx tests/portal.e2e.ts",
    "test:desktop": "tsx tests/desktop.e2e.ts",
    "test:codex-native": "tsx tests/codex-native.e2e.ts",
    "desktop:stage": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "aegis:compile": "node scripts/aegis-compile.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@google/gemini-cli": "0.66.0",
    "@openai/codex": "0.166.0",
    "@openzeppelin/contracts": "5.6.1",
    "@vercel/sandbox": "3.9.1",
    "better-auth": "1.7.15",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "ganache": "7.9.2",
    "prettier": "3.9.10",
    "solc": "0.8.30",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

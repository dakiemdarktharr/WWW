{
  "name": "relay-workspace",
  "version": "0.9.16",
  "private": true,
  "overrides": {
    "zod": "$zod",
    "pptxgenjs": {
      "image-size": "2.1.0"
    }
  },
  "type": "module",
  "description": "Kivuno â€” a desktop workspace for real Codex teams",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fuji-demo": "node scripts/dev-fuji-demo.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-cloud.mjs",
    "build:release": "node scripts/build-release.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:cloud": "tsx tests/cloud.e2e.ts",
    "test:portal": "tsx tests/portal.e2e.ts",
    "test:desktop": "tsx tests/desktop.e2e.ts",
    "test:collaboration": "tsx tests/collaboration.e2e.ts",
    "test:chat": "tsx tests/chat.e2e.ts",
    "test:team-model-picker": "tsx tests/team-model-picker.e2e.ts",
    "test:codex-native": "tsx tests/codex-native.e2e.ts",
    "desktop:stage": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:package-linux": "node scripts/package-linux.mjs",
    "macos:installer": "npm run build && node scripts/package-macos.mjs",
    "aegis:compile": "node scripts/aegis-compile.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:download": "node scripts/verify-download.mjs",
    "test:claude-native": "tsx tests/claude-native.e2e.ts",
    "test:desktop-package": "tsx tests/desktop-package.e2e.ts",
    "test:macos-installer": "tsx tests/macos-installer.e2e.ts",
    "test:sade": "tsx --test --test-concurrency=2 tests/sade.test.ts tests/workflow-plan.test.ts tests/workflows.test.ts tests/store.test.ts tests/handoffs.test.ts tests/runners.test.ts tests/managed-providers.test.ts tests/machine-execution.test.ts tests/shared-sade.test.ts",
    "test:shared-sade": "tsx --test tests/shared-sade.test.ts",
    "payment:compile": "node scripts/kivuno-payment-compile.mjs",
    "payment:compile:test": "node scripts/kivuno-payment-compile.mjs --test-shanghai"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@openai/codex": "0.166.0",
    "@openzeppelin/contracts": "5.6.1",
    "@vercel/functions": "3.11.3",
    "@vercel/sandbox": "3.9.1",
    "better-auth": "1.7.15",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "lucide-react": "1.66.0",
    "mongodb": "7.1.0",
    "motion": "14.9.0",
    "npm": "12.2.2",
    "pptxgenjs": "4.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tar": "7.5.22",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "ganache": "7.9.2",
    "prettier": "3.9.10",
    "solc": "0.8.30",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
